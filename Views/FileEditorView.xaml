<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FileFox.Views.FileEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Action Bar -->
        <Border Grid.Row="0"
                Margin="8,8,8,4"
                Padding="12,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE70F;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="FileNameText" FontSize="16" FontWeight="Bold" Text="File Editor" />
                    <TextBlock x:Name="RemotePathText" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Click="SaveAndUpload_Click" Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74E;" FontSize="14" />
                            <TextBlock Text="Save &amp; Upload" />
                        </StackPanel>
                    </Button>
                    <Button Click="Cancel_Click" Content="Cancel" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Editor TextBox -->
        <Border Grid.Row="1"
                Margin="8,4,8,6"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <TextBox x:Name="FileContentTextBox"
                     Padding="12"
                     AcceptsReturn="True"
                     FontFamily="Cascadia Mono, Consolas, Courier New"
                     FontSize="13"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap" />
        </Border>

        <!-- Status Info Bar -->
        <Border Grid.Row="2" Margin="8,0,8,6" Padding="10,6">
            <TextBlock x:Name="StatusInfoText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Ready" />
        </Border>
    </Grid>
</UserControl>
