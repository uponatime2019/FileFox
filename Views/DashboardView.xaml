<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FileFox.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:FileFox.Models"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="28,24" Spacing="24" HorizontalAlignment="Stretch">
            
            <!-- Dashboard Title / Header -->
            <Grid>
                <StackPanel Spacing="4">
                    <TextBlock Text="Connection Dashboard" FontSize="26" FontWeight="Bold" />
                    <TextBlock Text="Connect to a remote server or pick from saved connections to open a new tab" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- Card 1: Create New Connection -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="16">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE710;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="New Saved Connection" FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>

                        <ComboBox x:Name="SiteComboBox"
                                  HorizontalAlignment="Right"
                                  Width="220"
                                  PlaceholderText="Preset from saved site..."
                                  ItemsSource="{x:Bind SavedSites}"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="SiteComboBox_SelectionChanged" />
                    </Grid>

                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.2*" />
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="ProtocolComboBox"
                                  Grid.Column="0"
                                  Header="Protocol"
                                  SelectedIndex="0"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="ProtocolComboBox_SelectionChanged">
                            <ComboBoxItem Content="FTP" Tag="Ftp" />
                            <ComboBoxItem Content="FTP + TLS" Tag="FtpsExplicit" />
                            <ComboBoxItem Content="Implicit FTPS" Tag="FtpsImplicit" />
                            <ComboBoxItem Content="SFTP" Tag="Sftp" />
                        </ComboBox>

                        <TextBox x:Name="HostTextBox"
                                 Grid.Column="1"
                                 Header="Host"
                                 PlaceholderText="ftp.example.com" />

                        <TextBox x:Name="PortTextBox"
                                 Grid.Column="2"
                                 Header="Port"
                                 InputScope="Number"
                                 Text="21" />

                        <TextBox x:Name="UsernameTextBox"
                                 Grid.Column="3"
                                 Header="Username"
                                 PlaceholderText="anonymous" />

                        <PasswordBox x:Name="PasswordInput"
                                     Grid.Column="4"
                                     Header="Password"
                                     PasswordRevealMode="Peek" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,8,0,0">
                        <Button Click="ClearForm_Click" Content="Clear" Width="80" />
                        <Button x:Name="ConnectButton"
                                Style="{StaticResource AccentButtonStyle}"
                                Padding="18,8"
                                Click="Connect_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8AF;" FontSize="16" />
                                <TextBlock Text="Save &amp; Connect Tab" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 2: Saved Connections List -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="16">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE8F1;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Saved Connections" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind SavedSites.Count, Mode=OneWay}"
                                       FontSize="14"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>

                        <TextBox x:Name="SearchBox"
                                 Width="220"
                                 HorizontalAlignment="Right"
                                 PlaceholderText="Search saved sites..."
                                 TextChanged="SearchBox_TextChanged" />
                    </Grid>

                    <ListView x:Name="SavedSitesListView"
                              ItemsSource="{x:Bind FilteredSavedSites}"
                              SelectionMode="None"
                              DoubleTapped="SavedSitesListView_DoubleTapped">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="Padding" Value="12,10" />
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ConnectionProfile">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,6"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Protocol}"
                                                   FontWeight="Bold"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="15" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Host}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text=":" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind Port}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="•" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="4,0" />
                                            <TextBlock Text="{x:Bind Username}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Content="Edit"
                                            Click="EditSite_Click"
                                            Tag="{x:Bind}"
                                            VerticalAlignment="Center" />

                                    <Button Grid.Column="3"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Click="ConnectSite_Click"
                                            Tag="{x:Bind}"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8AF;" FontSize="12" />
                                            <TextBlock Text="Connect" />
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="4"
                                            Click="DeleteSite_Click"
                                            Tag="{x:Bind}"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Delete Saved Site">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock x:Name="EmptySitesTextBlock"
                               Text="No saved connections found."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               FontStyle="Italic"
                               HorizontalAlignment="Center"
                               Margin="0,16"
                               Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- Card 3: Settings -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="16">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE713;" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>

                        <Button x:Name="ToggleSettingsExpandButton"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="ToggleSettingsExpand_Click"
                                ToolTipService.ToolTip="Toggle settings view">
                            <FontIcon x:Name="ToggleSettingsExpandIcon" Glyph="&#xE70D;" FontSize="14" />
                        </Button>
                    </Grid>

                    <Grid x:Name="SettingsBodyGrid"
                          Visibility="Collapsed"
                          RowSpacing="16"
                          ColumnSpacing="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Theme Setting -->
                        <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="App Theme" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Switch between Dark mode and Light mode" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button x:Name="ThemeToggleButton"
                                Grid.Row="0"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Click="ThemeToggle_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:Name="ThemeToggleIcon" Glyph="&#xE708;" FontSize="14" />
                                <TextBlock x:Name="ThemeToggleText" Text="Dark Mode" />
                            </StackPanel>
                        </Button>

                        <!-- Start with Windows -->
                        <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Start with Windows" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Launch hidden in the notification area when Windows starts" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="StartWithWindowsToggle"
                                      Grid.Row="1"
                                      Grid.Column="1"
                                      VerticalAlignment="Center"
                                      OnContent="On"
                                      OffContent="Off"
                                      Toggled="StartWithWindowsToggle_Toggled" />

                        <!-- Close to notification area -->
                        <StackPanel Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Close to notification area" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="Keep transfers and sessions running in background when closing window" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="CloseToTrayToggle"
                                      Grid.Row="2"
                                      Grid.Column="1"
                                      VerticalAlignment="Center"
                                      OnContent="On"
                                      OffContent="Off"
                                      Toggled="CloseToTrayToggle_Toggled" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
